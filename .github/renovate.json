{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:monthly",
    "schedule:automergeDaily"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "prHourlyLimit": 20,
  "labels": [
    "dependencies"
  ],
  "assignees": [
    "bkis"
  ],
  "assigneesSampleSize": 1,
  "reviewers": [
    "bkis"
  ],
  "reviewersSampleSize": 1,
  "automerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "possibly breaking"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "matchCurrentVersion": "<1.0.0",
      "labels": [
        "possibly breaking"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "matchPackageNames": [
        "typescript",
        "python"
      ],
      "automerge": false
    }
  ]
}
