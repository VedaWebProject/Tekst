{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:monthly",
    "schedule:automergeDaily"
  ],
  "baseBranchPatterns": ["main"],
  "prHourlyLimit": 20,
  "labels": ["dependencies"],
  "assignees": ["bkis"],
  "assigneesSampleSize": 1,
  "reviewers": ["bkis"],
  "reviewersSampleSize": 1,
  "automerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["possibly breaking"]
    },
    {
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": ["major", "minor"],
      "automerge": false,
      "labels": ["possibly breaking"]
    },
    {
      "matchPackageNames": ["typescript", "python"],
      "matchUpdateTypes": ["major", "minor"],
      "automerge": false
    },
    {
      "matchPackageNames": ["mongo"],
      "matchFileNames": ["dev/compose.yml"],
      "enabled": false
    }
  ]
}
